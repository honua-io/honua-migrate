{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": { "noForEach": "off", "useLiteralKeys": "off" },
      "correctness": { "noSelfAssign": "off" },
      "performance": { "noDelete": "off" },
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "useNodejsImportProtocol": "off"
      },
      "suspicious": { "noConfusingVoidType": "off", "noExplicitAny": "warn" }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "overrides": [
    {
      "includes": ["**/upstream/test/**/*.ts"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ],
  "files": {
    "includes": [
      "**/upstream/src/**/*.ts",
      "**/upstream/test/**/*.ts",
      "!**/dist",
      "!**/node_modules",
      "!**/upstream/test/fixtures"
    ]
  }
}
